# ───────── Semua OPSIONAL, tetapi LLM_API_KEY sangat disarankan agar AI cepat & stabil ─────────

# [DISARANKAN] Penyedia utama (kompatibel OpenAI). Default = Google Gemini (gratis):
#   buat key di https://aistudio.google.com/apikey lalu isi di bawah.
LLM_API_KEY=
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.5-flash-lite
# (contoh Groq: LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.3-70b-versatile — Groq tanpa vision)

# Pollinations (analisis gambar cadangan + pembuat gambar). Key gratis: https://enter.pollinations.ai
POLLINATIONS_API_KEY=

# URL situs asli (untuk canonical, Open Graph, sitemap). Isi dengan domain kamu.
SITE_URL=

# Urutan & perilaku penyedia
# PROVIDERS=llm,kmsr,carpathian,pollinations
# HEDGE_MS=3500          # penyedia berikutnya ikut jalan jika yang pertama belum menjawab selama ini
# HEALTH_KEY=            # jika diisi, /api/health butuh ?key=...

CARPATHIAN_MODEL=4e069071635c5568
CARPATHIAN_UPLOAD_PATH=
KMSR_USER_ID=
DEBUG=
